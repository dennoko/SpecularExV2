        //----------------------------------------------------------------------------------------------------------------------
        // Packed mask (1: R:Specular 2nd  G:Rim Light 2nd  B:Normal Map 3rd  A:World MatCap /
        //              2: R:Specular 3rd  G:Rim Light 3rd  B:Normal Map 4th  A:shared noise).
        // Baked in the editor from the individual *_MaskTex slots below (SpecularExPackedMaskStore) and
        // the ONLY mask texture the shader declares, which keeps the texture-parameter count far below
        // the GPU limit of 64 even in lilToon's all-features-on build.
        [NoScaleOffset][HideInInspector] _CustomMaskPacked ("Packed Mask", 2D) = "white" {}
        [NoScaleOffset][HideInInspector] _CustomMaskPacked2 ("Packed Mask 2", 2D) = "white" {}

        // The *_MaskTex slots are authoring-only (never declared in HLSL). Their _ST IS used: each channel
        // of _CustomMaskPacked is sampled with its own slot's tiling/offset.

        // Shared noise mask (packed 2 .a), used by Specular 2nd/3rd, MatCap and Rim Light 2nd/3rd through their
        // *NoiseStrength. Its own _ST is unused: each of those layers has its own *NoiseST (tiling xy, offset zw).
        [NoScaleOffset] _CustomNoiseMaskTex ("Noise Mask", 2D) = "white" {}

        //----------------------------------------------------------------------------------------------------------------------
        // Specular 2nd
        [HideInInspector] _CustomRefl2ndUIEnabled ("Enable Specular 2nd", Float) = 0
        _CustomRefl2ndEnabled ("Enable Specular 2nd", Float) = 0
        [HDR] _CustomRefl2ndColor ("Specular 2nd Color", Color) = (1, 1, 1, 1)
        _CustomRefl2ndStrength ("Specular 2nd Strength", Range(0, 10)) = 1
        _CustomRefl2ndMode ("Specular 2nd Mode", Float) = 0
        _CustomRefl2ndSmoothness ("Specular 2nd Smoothness", Range(0, 1)) = 0.8
        _CustomRefl2ndMetallic ("Specular 2nd Metallic", Range(0, 1)) = 0
        _CustomRefl2ndReflectance ("Specular 2nd Reflectance", Range(0, 1)) = 0.04
        _CustomRefl2ndNormalStrength ("Specular 2nd Normal Strength", Range(0, 1)) = 1
        _CustomRefl2ndShadowAttenuation ("Specular 2nd Shadow Attenuation", Range(0, 1)) = 1
        _CustomRefl2ndMainColorStrength ("Specular 2nd Main Color Strength", Range(0, 1)) = 0
        _CustomRefl2ndApplyFA ("Specular 2nd Apply ForwardAdd", Float) = 1
        // Light direction override (ForwardBase only): blends fd.L toward a camera-relative direction
        // (x = right, y = up, z = toward the viewer). Only the direction changes; brightness still follows
        // the scene lighting.
        _CustomRefl2ndFakeLightBlend ("Specular 2nd Fake Light Blend", Range(0, 1)) = 0
        _CustomRefl2ndFakeLightDir ("Specular 2nd Fake Light Direction", Vector) = (0.3, 0.5, 1, 0)
        _CustomRefl2ndEnableLighting ("Specular 2nd Enable Lighting", Range(0, 1)) = 1
        _CustomRefl2ndClearCoat ("Specular 2nd Clear Coat", Float) = 0
        _CustomRefl2ndFresnelStrength ("Specular 2nd Fresnel Strength", Range(0, 1)) = 0
        _CustomRefl2ndFresnelPower ("Specular 2nd Fresnel Power", Range(0.5, 10)) = 5
        _CustomRefl2ndMaskTex ("Specular 2nd Mask", 2D) = "white" {}
        _CustomRefl2ndNoiseStrength ("Specular 2nd Noise Strength", Range(0, 1)) = 0
        _CustomRefl2ndNoiseST ("Specular 2nd Noise Tiling Offset", Vector) = (1, 1, 0, 0)

        //----------------------------------------------------------------------------------------------------------------------
        // Specular 3rd
        [HideInInspector] _CustomRefl3rdUIEnabled ("Enable Specular 3rd", Float) = 0
        _CustomRefl3rdEnabled ("Enable Specular 3rd", Float) = 0
        [HDR] _CustomRefl3rdColor ("Specular 3rd Color", Color) = (1, 1, 1, 1)
        _CustomRefl3rdStrength ("Specular 3rd Strength", Range(0, 10)) = 1
        _CustomRefl3rdMode ("Specular 3rd Mode", Float) = 0
        _CustomRefl3rdSmoothness ("Specular 3rd Smoothness", Range(0, 1)) = 0.8
        _CustomRefl3rdMetallic ("Specular 3rd Metallic", Range(0, 1)) = 0
        _CustomRefl3rdReflectance ("Specular 3rd Reflectance", Range(0, 1)) = 0.04
        _CustomRefl3rdNormalStrength ("Specular 3rd Normal Strength", Range(0, 1)) = 1
        _CustomRefl3rdShadowAttenuation ("Specular 3rd Shadow Attenuation", Range(0, 1)) = 1
        _CustomRefl3rdMainColorStrength ("Specular 3rd Main Color Strength", Range(0, 1)) = 0
        _CustomRefl3rdApplyFA ("Specular 3rd Apply ForwardAdd", Float) = 1
        // Light direction override (ForwardBase only): blends fd.L toward a camera-relative direction
        // (x = right, y = up, z = toward the viewer). Only the direction changes; brightness still follows
        // the scene lighting.
        _CustomRefl3rdFakeLightBlend ("Specular 3rd Fake Light Blend", Range(0, 1)) = 0
        _CustomRefl3rdFakeLightDir ("Specular 3rd Fake Light Direction", Vector) = (0.3, 0.5, 1, 0)
        _CustomRefl3rdEnableLighting ("Specular 3rd Enable Lighting", Range(0, 1)) = 1
        _CustomRefl3rdClearCoat ("Specular 3rd Clear Coat", Float) = 0
        _CustomRefl3rdFresnelStrength ("Specular 3rd Fresnel Strength", Range(0, 1)) = 0
        _CustomRefl3rdFresnelPower ("Specular 3rd Fresnel Power", Range(0.5, 10)) = 5
        _CustomRefl3rdMaskTex ("Specular 3rd Mask", 2D) = "white" {}
        _CustomRefl3rdNoiseStrength ("Specular 3rd Noise Strength", Range(0, 1)) = 0
        _CustomRefl3rdNoiseST ("Specular 3rd Noise Tiling Offset", Vector) = (1, 1, 0, 0)

        //----------------------------------------------------------------------------------------------------------------------
        // World-Oriented Dual-Hemisphere MatCap
        [HideInInspector] _CustomMatcapUIEnabled ("Enable World MatCap", Float) = 0
        _CustomMatcapEnabled ("Enable World MatCap", Float) = 0
        // The only matcap texture (name kept so existing assignments survive; the old separate Back slot is
        // gone). World-fixed lookups mirror it onto the back hemisphere.
        [NoScaleOffset] _CustomMatcapFrontTex ("World MatCap Texture", 2D) = "black" {}
        [HDR] _CustomMatcapColor ("World MatCap Color", Color) = (1, 1, 1, 1)
        _CustomMatcapAlpha ("World MatCap Strength", Range(0, 1)) = 1
        _CustomMatcapBlendMode ("World MatCap Blend Mode", Float) = 1
        _CustomMatcapBlur ("World MatCap Blur", Range(0, 10)) = 0
        // World fixing (name kept for compatibility): 0 = View (ordinary matcap), 1 = World fixed, in between
        // the lookup directions are blended. Older materials may hold 2 (removed Object mode); the shader
        // saturates it to 1.
        _CustomMatcapWorldFixed ("World MatCap World Fixing", Range(0, 1)) = 0
        _CustomMatcapWorldRotation ("World MatCap Yaw Rotation", Range(-180, 180)) = 0
        _CustomMatcapNormalStrength ("World MatCap Normal Strength", Range(0, 1)) = 1
        _CustomMatcapEnableLighting ("World MatCap Enable Lighting", Range(0, 1)) = 1
        _CustomMatcapShadowStrength ("World MatCap Shadow Strength", Range(0, 1)) = 0
        _CustomMatcapDisableBackface ("World MatCap Disable Backface", Float) = 1
        // 0 keeps the matcap out of the ForwardAdd pass (per additional light); 1 = previous behavior.
        _CustomMatcapApplyFA ("World MatCap Apply ForwardAdd", Float) = 1
        _CustomMatcapHSVG ("World MatCap HSVG", Vector) = (0, 1, 1, 1)
        _CustomMatcapMainColorStrength ("World MatCap Main Color Strength", Range(0, 1)) = 0
        _CustomMatcapMaskTex ("World MatCap Mask", 2D) = "white" {}
        _CustomMatcapNoiseStrength ("World MatCap Noise Strength", Range(0, 1)) = 0
        _CustomMatcapNoiseST ("World MatCap Noise Tiling Offset", Vector) = (1, 1, 0, 0)

        //----------------------------------------------------------------------------------------------------------------------
        // Normal Map 3rd
        [HideInInspector] _CustomNormal3rdUIEnabled ("Enable Normal Map 3rd", Float) = 0
        _CustomNormal3rdEnabled ("Enable Normal Map 3rd", Float) = 0
        [Normal] _CustomNormal3rdTex ("Normal Map 3rd", 2D) = "bump" {}
        _CustomNormal3rdStrength ("Normal Map 3rd Strength", Range(-2, 2)) = 1
        _CustomNormal3rdTex_UVMode ("Normal Map 3rd UV Mode", Float) = 0
        // x, y = scroll speed, z = angle (rad), w = rotation speed (lilToon _MainTex_ScrollRotate layout).
        _CustomNormal3rdTex_ScrollRotate ("Normal Map 3rd Scroll Rotate", Vector) = (0, 0, 0, 0)
        // x = fade start [m], y = fade end [m], z = fade strength (0 = off).
        _CustomNormal3rdDistanceFade ("Normal Map 3rd Distance Fade", Vector) = (2, 10, 0, 0)
        _CustomNormal3rdMaskTex ("Normal Map 3rd Mask", 2D) = "white" {}

        //----------------------------------------------------------------------------------------------------------------------
        // Normal Map 4th (blended on top of 3rd; same layout)
        [HideInInspector] _CustomNormal4thUIEnabled ("Enable Normal Map 4th", Float) = 0
        _CustomNormal4thEnabled ("Enable Normal Map 4th", Float) = 0
        [Normal] _CustomNormal4thTex ("Normal Map 4th", 2D) = "bump" {}
        _CustomNormal4thStrength ("Normal Map 4th Strength", Range(-2, 2)) = 1
        _CustomNormal4thTex_UVMode ("Normal Map 4th UV Mode", Float) = 0
        _CustomNormal4thTex_ScrollRotate ("Normal Map 4th Scroll Rotate", Vector) = (0, 0, 0, 0)
        _CustomNormal4thDistanceFade ("Normal Map 4th Distance Fade", Vector) = (2, 10, 0, 0)
        _CustomNormal4thMaskTex ("Normal Map 4th Mask", 2D) = "white" {}

        //----------------------------------------------------------------------------------------------------------------------
        // Rim Light 2nd
        [HideInInspector] _CustomRim2ndUIEnabled ("Enable Rim Light 2nd", Float) = 0
        _CustomRim2ndEnabled ("Enable Rim Light 2nd", Float) = 0
        [HDR] _CustomRim2ndColor ("Rim Light 2nd Color", Color) = (1, 1, 1, 1)
        _CustomRim2ndStrength ("Rim Light 2nd Strength", Range(0, 1)) = 1
        _CustomRim2ndPower ("Rim Light 2nd Power", Range(0.1, 32)) = 3
        _CustomRim2ndBorder ("Rim Light 2nd Border", Range(0, 1)) = 0.5
        _CustomRim2ndBlur ("Rim Light 2nd Blur", Range(0, 1)) = 1
        // +: upward-facing surfaces only, -: downward-facing only, 0: no restriction (world up).
        _CustomRim2ndVerticalBias ("Rim Light 2nd Vertical Bias", Range(-1, 1)) = 0
        _CustomRim2ndBacklight ("Rim Light 2nd Backlight Boost", Range(0, 4)) = 0
        // Tints the rim by the light color (not in Multiply mode). 1 like lilToon's _RimEnableLighting, so the
        // rim does not glow in dark worlds; 0 keeps the old emissive-looking rim.
        _CustomRim2ndEnableLighting ("Rim Light 2nd Enable Lighting", Range(0, 1)) = 1
        _CustomRim2ndBlendMode ("Rim Light 2nd Blend Mode", Float) = 1
        _CustomRim2ndNormalStrength ("Rim Light 2nd Normal Strength", Range(0, 1)) = 1
        _CustomRim2ndShadowAttenuation ("Rim Light 2nd Shadow Attenuation", Range(0, 1)) = 0
        _CustomRim2ndMainColorStrength ("Rim Light 2nd Main Color Strength", Range(0, 1)) = 0
        _CustomRim2ndMaskTex ("Rim Light 2nd Mask", 2D) = "white" {}
        _CustomRim2ndNoiseStrength ("Rim Light 2nd Noise Strength", Range(0, 1)) = 0
        _CustomRim2ndNoiseST ("Rim Light 2nd Noise Tiling Offset", Vector) = (1, 1, 0, 0)

        //----------------------------------------------------------------------------------------------------------------------
        // Rim Light 3rd
        [HideInInspector] _CustomRim3rdUIEnabled ("Enable Rim Light 3rd", Float) = 0
        _CustomRim3rdEnabled ("Enable Rim Light 3rd", Float) = 0
        [HDR] _CustomRim3rdColor ("Rim Light 3rd Color", Color) = (1, 1, 1, 1)
        _CustomRim3rdStrength ("Rim Light 3rd Strength", Range(0, 1)) = 1
        _CustomRim3rdPower ("Rim Light 3rd Power", Range(0.1, 32)) = 3
        _CustomRim3rdBorder ("Rim Light 3rd Border", Range(0, 1)) = 0.5
        _CustomRim3rdBlur ("Rim Light 3rd Blur", Range(0, 1)) = 1
        // +: upward-facing surfaces only, -: downward-facing only, 0: no restriction (world up).
        _CustomRim3rdVerticalBias ("Rim Light 3rd Vertical Bias", Range(-1, 1)) = 0
        _CustomRim3rdBacklight ("Rim Light 3rd Backlight Boost", Range(0, 4)) = 0
        // Tints the rim by the light color (not in Multiply mode). 1 like lilToon's _RimEnableLighting, so the
        // rim does not glow in dark worlds; 0 keeps the old emissive-looking rim.
        _CustomRim3rdEnableLighting ("Rim Light 3rd Enable Lighting", Range(0, 1)) = 1
        _CustomRim3rdBlendMode ("Rim Light 3rd Blend Mode", Float) = 1
        _CustomRim3rdNormalStrength ("Rim Light 3rd Normal Strength", Range(0, 1)) = 1
        _CustomRim3rdShadowAttenuation ("Rim Light 3rd Shadow Attenuation", Range(0, 1)) = 0
        _CustomRim3rdMainColorStrength ("Rim Light 3rd Main Color Strength", Range(0, 1)) = 0
        _CustomRim3rdMaskTex ("Rim Light 3rd Mask", 2D) = "white" {}
        _CustomRim3rdNoiseStrength ("Rim Light 3rd Noise Strength", Range(0, 1)) = 0
        _CustomRim3rdNoiseST ("Rim Light 3rd Noise Tiling Offset", Vector) = (1, 1, 0, 0)

